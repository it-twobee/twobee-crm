# Supabase — vai su supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Assistente AI (lib/ai) — provider OpenAI-compatibile
# groq: usa GROQ_API_KEY, già presente per i 28 endpoint generativi.
# openai: richiede un account platform.openai.com (NON l'abbonamento ChatGPT).
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-key

# Modello Groq per TUTTE le route AI (lib/ai/model.ts). Non hardcodarlo nel
# codice: llama-3.3-70b-versatile è stato dismesso e stava copiato in 28 file.
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# AI_MODEL=                      # override globale, ha la precedenza sui due sopra
# AI_MAX_TOKENS=3000             # tetto per turno dell'assistente (reasoning incluso)
# AI_ASSISTANT_DAILY_LIMIT=100   # turni per utente nelle ultime 24h (admin ×3)

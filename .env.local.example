# Supabase — vai su supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar — client OAuth «Applicazione web», Google Calendar API abilitata.
# Redirect autorizzati nella Google Cloud Console:
# http://localhost:3000/api/google/callback e https://os.twobee.it/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tracking (§316) — genera entrambe con: openssl rand -hex 32
# Chiave AES-256 con cui sono cifrati chiavi API e password dei clienti.
# Persa la chiave, i segreti salvati non si recuperano: vanno reinseriti.
VAULT_KEY=
# Bearer che autorizza POST /api/tracking/qa/run (task pianificato Coolify)
TRACKING_CRON_SECRET=

# §346 — il cron delle ricorrenze (`/api/recurrences/run`, task pianificato di
# Coolify). Senza, `fromCron()` rifiuta e le occorrenze le genera solo un admin
# a mano: la seconda schedulazione che fallisce in silenzio.
RECURRENCE_CRON_SECRET=

# §370 — il foglio dei lead (Meta Lead Ads) da cui pesca `/api/sales/sync`.
# È l'indirizzo CSV, non il link del foglio: Condividi → «Chiunque abbia il
# link — Visualizzatore», poi .../d/<ID>/export?format=csv&gid=<GID>
# Senza, la sezione Commerciale resta viva ma il giro non legge niente.
SALES_SHEET_CSV_URL=
# Bearer che autorizza POST /api/sales/sync (task pianificato Coolify, 03:00).
# Genera con: openssl rand -hex 32
SALES_SYNC_SECRET=
# §434 — il ritorno sul foglio: il JSON intero della chiave di un account di
# servizio Google (Google Cloud → IAM → Account di servizio → Chiavi → JSON),
# su una riga. Il foglio va condiviso come Editor con il suo client_email.
# Senza, il giro legge i lead nuovi e non scrive niente sul foglio.
GOOGLE_SHEETS_SA_JSON=

# §392 — il giro che apre i periodi dei progetti (`/api/periods/run`, task
# pianificato Coolify alle 04:00). Senza, `fromCron()` rifiuta e i periodi
# li apre solo un admin a mano dal bottone sulla pagina del progetto.
# Genera con: openssl rand -hex 32
PERIODS_CRON_SECRET=
